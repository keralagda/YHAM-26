generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String
  role      String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteSection {
  id          String   @id @default(cuid())
  sectionKey  String   @unique
  label       String
  order       Int      @default(0)
  visible     Boolean  @default(true)
  sectionType String   @default("content")
  contentHi   String   @default("{}")
  contentEn   String   @default("{}")
  contentMl   String   @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SiteSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String @default("")
}
