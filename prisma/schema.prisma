generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String?
  password  String
  role      String    @default("admin")
  sessions  Session[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model SiteSection {
  id          String   @id @default(cuid())
  sectionKey  String   @unique
  label       String
  order       Int      @default(0)
  visible     Boolean  @default(true)
  sectionType String   @default("content")
  contentHi   String   @default("{}")
  contentEn   String   @default("{}")
  contentMl   String   @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SiteSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String @default("")
}

model Media {
  id        String   @id @default(cuid())
  filename  String
  url       String
  mimeType  String   @default("image/jpeg")
  size      Int      @default(0)
  alt       String   @default("")
  category  String   @default("general")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Member {
  id          String   @id @default(cuid())
  nameHi      String
  nameEn      String
  nameMl      String
  roleHi      String
  roleEn      String
  roleMl      String
  phone       String   @default("")
  email       String   @default("")
  imageUrl    String   @default("")
  category    String   @default("yham")
  order       Int      @default(0)
  visible     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String   @default("")
  subject   String   @default("")
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  eventType String
  page      String   @default("/")
  metadata  String   @default("{}")
  userAgent String   @default("")
  ip        String   @default("")
  createdAt DateTime @default(now())
}

// ─── Page Builder Models ─────────────────────────────────────────────────────

model Page {
  id          String   @id @default(cuid())
  slug        String   @unique
  titleHi     String   @default("")
  titleEn     String   @default("")
  titleMl     String   @default("")
  description String   @default("")
  template    String   @default("default") // default, fullwidth, sidebar, landing
  theme       String   @default("saffron") // saffron, red-white, navy, green
  published   Boolean  @default(false)
  isHomePage  Boolean  @default(false)
  order       Int      @default(0)
  blocks      Block[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Block {
  id        String   @id @default(cuid())
  pageId    String
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  type      String   // hero, text, leaders, gallery, cta, stats, contact, video, spacer, columns
  order     Int      @default(0)
  visible   Boolean  @default(true)
  content   String   @default("{}") // JSON: all block data (multilingual content, settings, styles)
  settings  String   @default("{}") // JSON: layout settings (bg color, padding, width, etc.)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BlockTemplate {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  type        String   // same as Block.type
  category    String   @default("general") // general, leadership, content, media, layout
  thumbnail   String   @default("")
  content     String   @default("{}") // default content JSON
  settings    String   @default("{}") // default settings JSON
  createdAt   DateTime @default(now())
}

// ─── Party Membership & Cadre Management ─────────────────────────────────────

model PartyMember {
  id              String   @id @default(cuid())
  // Personal
  fullName        String
  fatherName      String   @default("")
  dob             String   @default("")
  gender          String   @default("")
  phone           String
  altPhone        String   @default("")
  email           String   @default("")
  aadharLast4     String   @default("")
  bloodGroup      String   @default("")
  photoUrl        String   @default("")
  // Address
  state           String   @default("")
  district        String   @default("")
  block           String   @default("")
  panchayat       String   @default("")
  ward            String   @default("")
  booth           String   @default("")
  pincode         String   @default("")
  fullAddress     String   @default("")
  // Political
  designation     String   @default("karyakarta") // national, state, district, block, panchayat, ward, booth, panna_pramukh, karyakarta
  referredBy      String   @default("")
  previousParty   String   @default("")
  voterIdNumber   String   @default("")
  assemblyConst   String   @default("")
  parlConst       String   @default("")
  // Professional
  occupation      String   @default("")
  education       String   @default("")
  skills          String   @default("")
  // Status
  status          String   @default("pending") // pending, verified, active, suspended
  verifiedAt      DateTime?
  verifiedBy      String   @default("")
  digitalIdUrl    String   @default("")
  // Metrics
  housesVisited   Int      @default(0)
  membersRecruited Int     @default(0)
  eventsAttended  Int      @default(0)
  socialShares    Int      @default(0)
  kpiScore        Int      @default(0)
  //
  notes           String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ─── Blood Bank ──────────────────────────────────────────────────────────────

model BloodDonor {
  id            String   @id @default(cuid())
  fullName      String
  phone         String
  altPhone      String   @default("")
  email         String   @default("")
  bloodGroup    String   // A+, A-, B+, B-, AB+, AB-, O+, O-
  dob           String   @default("")
  gender        String   @default("")
  weight        String   @default("")
  state         String   @default("")
  district      String   @default("")
  city          String   @default("")
  pincode       String   @default("")
  address       String   @default("")
  lastDonation  String   @default("")
  totalDonations Int     @default(0)
  available     Boolean  @default(true)
  medicalNotes  String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model BloodRequest {
  id            String   @id @default(cuid())
  patientName   String
  bloodGroup    String
  units         Int      @default(1)
  hospital      String   @default("")
  city          String   @default("")
  district      String   @default("")
  state         String   @default("")
  contactName   String
  contactPhone  String
  urgency       String   @default("normal") // normal, urgent, critical
  status        String   @default("open") // open, fulfilled, cancelled
  notes         String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ─── Grievance Redressal (Jan Sunwai) ────────────────────────────────────────

model Grievance {
  id            String   @id @default(cuid())
  ticketNo      String   @unique @default(cuid())
  citizenName   String
  citizenPhone  String
  citizenEmail  String   @default("")
  category      String   @default("general") // roads, water, electricity, sanitation, education, health, corruption, other
  subject       String
  description   String
  location      String   @default("")
  state         String   @default("")
  district      String   @default("")
  ward          String   @default("")
  imageUrls     String   @default("[]") // JSON array of image URLs
  assignedTo    String   @default("")
  status        String   @default("open") // open, in_progress, resolved, closed, escalated
  priority      String   @default("medium") // low, medium, high, critical
  resolution    String   @default("")
  resolvedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ─── Events & Rally Management ───────────────────────────────────────────────

model PartyEvent {
  id            String   @id @default(cuid())
  title         String
  description   String   @default("")
  eventType     String   @default("rally") // rally, meeting, padyatra, convention, virtual, training
  date          String
  time          String   @default("")
  venue         String   @default("")
  city          String   @default("")
  district      String   @default("")
  state         String   @default("")
  expectedCrowd Int      @default(0)
  actualCrowd   Int      @default(0)
  chiefGuest    String   @default("")
  organizer     String   @default("")
  status        String   @default("upcoming") // upcoming, ongoing, completed, cancelled
  imageUrl      String   @default("")
  streamUrl     String   @default("")
  notes         String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ─── Donations & Treasury ────────────────────────────────────────────────────

model Donation {
  id            String   @id @default(cuid())
  donorName     String
  donorPhone    String   @default("")
  donorEmail    String   @default("")
  amount        Float
  method        String   @default("upi") // upi, bank_transfer, cash, cheque
  transactionId String   @default("")
  state         String   @default("")
  district      String   @default("")
  purpose       String   @default("general") // general, campaign, event, relief
  status        String   @default("confirmed") // pending, confirmed, failed
  receiptUrl    String   @default("")
  notes         String   @default("")
  createdAt     DateTime @default(now())
}
