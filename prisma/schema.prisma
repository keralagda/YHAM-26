generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String?
  password  String
  role      String    @default("admin")
  sessions  Session[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model SiteSection {
  id          String   @id @default(cuid())
  sectionKey  String   @unique
  label       String
  order       Int      @default(0)
  visible     Boolean  @default(true)
  sectionType String   @default("content")
  contentHi   String   @default("{}")
  contentEn   String   @default("{}")
  contentMl   String   @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SiteSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String @default("")
}

model Media {
  id        String   @id @default(cuid())
  filename  String
  url       String
  mimeType  String   @default("image/jpeg")
  size      Int      @default(0)
  alt       String   @default("")
  category  String   @default("general")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Member {
  id          String   @id @default(cuid())
  nameHi      String
  nameEn      String
  nameMl      String
  roleHi      String
  roleEn      String
  roleMl      String
  phone       String   @default("")
  email       String   @default("")
  imageUrl    String   @default("")
  category    String   @default("yham")
  order       Int      @default(0)
  visible     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String   @default("")
  subject   String   @default("")
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  eventType String
  page      String   @default("/")
  metadata  String   @default("{}")
  userAgent String   @default("")
  ip        String   @default("")
  createdAt DateTime @default(now())
}
